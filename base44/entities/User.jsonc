{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "christian_content": {
      "type": "boolean",
      "default": false,
      "description": "Whether to include Faith-Based content"
    },
    "selected_categories": {
      "type": "string",
      "description": "JSON array of selected category slugs"
    },
    "delivery_method": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "none"
      ],
      "default": "email",
      "description": "How daily positivity is delivered: Email, SMS, or None"
    },
    "phone_number": {
      "type": "string",
      "description": "User phone number for SMS delivery"
    },
    "country_code": {
      "type": "string",
      "default": "US",
      "description": "Country code for phone number formatting"
    },
    "morning_time": {
      "type": "string",
      "default": "07:00",
      "description": "Morning delivery time (user local)"
    },
    "midday_time": {
      "type": "string",
      "default": "12:00",
      "description": "Midday delivery time (user local)"
    },
    "evening_time": {
      "type": "string",
      "default": "19:00",
      "description": "Evening delivery time (user local)"
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York",
      "description": "User IANA timezone for personalized delivery scheduling"
    },
    "birthday": {
      "type": "string",
      "format": "date",
      "description": "User's birthday (YYYY-MM-DD)"
    },
    "is_birthday_today": {
      "type": "boolean",
      "default": false,
      "description": "Flag set by birthday automation on the user's birthday"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "cancelled",
        "expired"
      ],
      "default": "trial",
      "description": "Current subscription status"
    },
    "trial_start_date": {
      "type": "string",
      "format": "date",
      "description": "When the 7-day trial started"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light"
    }
  }
}