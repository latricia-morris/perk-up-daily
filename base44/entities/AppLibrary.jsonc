{
  "name": "AppLibrary",
  "type": "object",
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "power_up",
        "quote",
        "affirmation",
        "scripture",
        "encouragement_note"
      ],
      "description": "Type of library content. 'power_up' is the canonical type for short high-impact content (replaces 'quote'). 'affirmation' displays as 'Declaration' to users."
    },
    "body": {
      "type": "string",
      "description": "The content text"
    },
    "author": {
      "type": "string",
      "description": "Author or attribution. For scriptures, use the Bible reference (e.g. Jeremiah 29:11 NIV)."
    },
    "category": {
      "type": "string",
      "enum": [
        "deep_faith",
        "rich_relationships",
        "strong_body",
        "clear_mind",
        "strong_business",
        "sound_money"
      ],
      "description": "Life area category"
    },
    "is_christian": {
      "type": "boolean",
      "default": false,
      "description": "Whether this content is Christian/faith-based"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Whether this item is in rotation"
    }
  },
  "required": [
    "content_type",
    "body",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}