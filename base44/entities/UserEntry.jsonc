{
  "name": "UserEntry",
  "type": "object",
  "properties": {
    "entry_type": {
      "type": "string",
      "enum": [
        "experience",
        "blessing",
        "life_win",
        "affirmation",
        "quote",
        "personal_note",
        "identity_swap",
        "scripture",
        "accomplishment",
        "milestone",
        "reflection",
        "vision_goal"
      ],
      "description": "Type of user entry"
    },
    "title": {
      "type": "string",
      "description": "Title or author/reference (for quotes/scriptures). For reflections, stores the prompt text. For vision_goal, the goal title."
    },
    "body": {
      "type": "string",
      "description": "Main entry content"
    },
    "old_belief": {
      "type": "string",
      "description": "For identity_swap: the old false belief being released"
    },
    "author": {
      "type": "string",
      "description": "Author attribution for quotes"
    },
    "reference": {
      "type": "string",
      "description": "Bible reference for scriptures (e.g. Jeremiah 29:11 NIV)"
    },
    "category": {
      "type": "string",
      "enum": [
        "deep_faith",
        "rich_relationships",
        "strong_body",
        "clear_mind",
        "strong_business",
        "sound_money"
      ],
      "description": "Life area category"
    },
    "entry_date": {
      "type": "string",
      "format": "date",
      "description": "Optional date for entries"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "For vision_goal: the target completion date"
    },
    "progress_stage": {
      "type": "string",
      "enum": [
        "looking_ahead",
        "in_process",
        "making_progress",
        "almost_there",
        "crushed_it"
      ],
      "description": "For vision_goal: current progress stage"
    },
    "location": {
      "type": "string",
      "description": "Optional location for entries"
    },
    "photo_url": {
      "type": "string",
      "description": "Optional photo URL"
    },
    "prompt_id": {
      "type": "string",
      "description": "For reflections: ID of the ReflectionPrompt this entry answers"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft"
      ],
      "default": "active",
      "description": "Active entries appear in deliveries, drafts do not"
    }
  },
  "required": [
    "entry_type",
    "body",
    "category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}