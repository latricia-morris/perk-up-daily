{
  "name": "UserEntry",
  "type": "object",
  "properties": {
    "entry_type": {
      "type": "string",
      "enum": [
        "experience",
        "blessing",
        "life_win",
        "affirmation",
        "quote",
        "personal_note",
        "identity_swap",
        "scripture",
        "accomplishment",
        "milestone"
      ],
      "description": "Type of user entry"
    },
    "title": {
      "type": "string",
      "description": "Optional title or author field for quotes/scriptures"
    },
    "body": {
      "type": "string",
      "description": "The entry content / true identity statement"
    },
    "old_belief": {
      "type": "string",
      "description": "For identity_swap: the old false belief being released"
    },
    "category": {
      "type": "string",
      "enum": [
        "deep_faith",
        "rich_relationships",
        "strong_body",
        "clear_mind",
        "strong_business",
        "sound_money"
      ],
      "description": "Life area category"
    },
    "entry_date": {
      "type": "string",
      "format": "date",
      "description": "Optional date for anniversary surfacing"
    },
    "photo_url": {
      "type": "string",
      "description": "Optional photo URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft"
      ],
      "default": "active",
      "description": "Active entries appear in deliveries, drafts do not"
    }
  },
  "required": [
    "entry_type",
    "body",
    "category"
  ]
}